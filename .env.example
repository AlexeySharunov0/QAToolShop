# Copy this file to .env and adjust the URLs if your local Toolshop uses other
# ports. The real .env is git-ignored and never committed.

# Local Toolshop instance (docker compose from the application repository).
# Do not point these at practicesoftwaretesting.com: the assignment requires a
# local instance, and traces/sessions must reference localhost.
UI_URL=http://localhost:4200
API_URL=http://localhost:8091

# Credentials of the seeded demo customer, listed in the application README.
# They are public and are used only for optional manual checks; every automated
# test registers its own throw-away customer through the API (see
# src/data/factories.ts), because a shared account is locked after three failed
# logins and would turn one negative test into a cascade.
DEMO_CUSTOMER_EMAIL=customer@practicesoftwaretesting.com
DEMO_CUSTOMER_PASSWORD=welcome01

# Seeded administrator. The admin area is out of scope; the value is kept only
# so the environment description is complete.
DEMO_ADMIN_EMAIL=admin@practicesoftwaretesting.com
DEMO_ADMIN_PASSWORD=welcome01
